# --- Database ---
# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://user:password@localhost:5432/yandex_dashboard?schema=public"

# --- NextAuth ---
# Generate with: openssl rand -base64 32
AUTH_SECRET="change-me-please"
# Base URL of the app (required in production).
AUTH_URL="http://localhost:3000"

# --- Yandex.Direct accounts ---
# Preferred format: one set of variables per account. Adding a new account means
# adding a new pair of variables — you never touch the existing ones.
#   YANDEX_ACCOUNT_<KEY>_TOKEN  (required) — standalone OAuth token
#   YANDEX_ACCOUNT_<KEY>_LABEL  (optional) — display name (falls back to <KEY>)
# <KEY> (e.g. ACC1) becomes the account id (lower-cased) and the cache key —
# keep it stable once chosen. Tokens are read only on the server and are NEVER
# sent to the browser, stored in the database, or committed to source control.
YANDEX_ACCOUNT_ACC1_TOKEN="AQAA...token1"
YANDEX_ACCOUNT_ACC1_LABEL="Клиент А"
YANDEX_ACCOUNT_ACC2_TOKEN="AQAA...token2"
YANDEX_ACCOUNT_ACC2_LABEL="Клиент Б"

# Optional — count "leads" only for specific Metrica goal ids (comma-separated).
# Per account, or a global fallback for all accounts. Empty = all conversions.
# YANDEX_ACCOUNT_ACC1_GOALS="12345,67890"
# YANDEX_LEAD_GOALS="12345,67890"
# Attribution model for goal conversions (default LSC — last significant click).
# YANDEX_ATTRIBUTION_MODEL="LSC"

# Legacy format (still supported, merged with the per-account variables above):
# YANDEX_ACCOUNTS='[{"id":"acc1","label":"Клиент А","token":"AQAA..."}]'

# Optional — map accounts to clients (one client may own several accounts).
# One "<accountId>=<Client>" per line; enables the "Клиент" filter. Keep this
# whole list in one variable and just paste an updated version to add clients.
# YANDEX_CLIENTS="acc1=Лесорубы
# acc2=Скуд
# acc3=Лесорубы
# acc4=Шеган"

# --- Cache ---
# How long a cached report snapshot stays fresh, in minutes (default 60).
CACHE_TTL_MINUTES="60"

# --- AI anomaly analysis (optional, "Аномалии" tab) ---
# Google AI Studio (Gemini) API key. Without it the tab shows a "not configured"
# notice. Get one at https://aistudio.google.com/ (Get API key).
GEMINI_API_KEY=""
# Gemini model to use (default gemini-2.5-flash).
GEMINI_MODEL="gemini-2.5-flash"

# --- Scheduled refresh (optional) ---
# Bearer token required to call GET /api/cron/refresh. Leave empty to disable auth.
CRON_SECRET=""

# --- Seed user (only used by `npm run db:seed`) ---
SEED_USER_EMAIL="admin@example.com"
SEED_USER_PASSWORD="change-me"
SEED_USER_NAME="Admin"
